# ── Base de données ──────────────────────────────────────────────────
DATABASE_URL=postgres://certfleet:changeme@db:5432/certfleet

# ── Accès à l'interface ──────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
ADMIN_TOKEN=

# Mettre à false UNIQUEMENT en développement local sans HTTPS.
COOKIE_SECURE=true

# ── Coffre des clés privées ──────────────────────────────────────────
# 32 octets en base64 : openssl rand -base64 32
# À DÉFINIR IMPÉRATIVEMENT. Sans elle, une clé est générée et stockée EN BASE,
# ce qui revient à chiffrer le coffre avec la clé posée dessus.
CERT_VAULT_KEY=

# ── Serveur ──────────────────────────────────────────────────────────
PORT=8080

# ── Cadence des tâches de fond (minutes) ─────────────────────────────
MONITOR_INTERVAL_MIN=360
RENEW_INTERVAL_MIN=720
AGENT_POLL_INTERVAL=60

# ── Comptes ──────────────────────────────────────────────────────────
# Premier administrateur, créé si la base n'en contient aucun d'actif.
# Sans BOOTSTRAP_PASSWORD, un mot de passe est tiré au hasard et affiché
# UNE SEULE FOIS dans les logs de démarrage.
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_PASSWORD=

# Durée de validité d'une session, en heures.
SESSION_HOURS=12

# Mettre à true si l'application est derrière un reverse proxy, pour que
# l'adresse réelle du client soit journalisée plutôt que celle du proxy.
TRUST_PROXY=false

# ── Annuaire (Active Directory / OpenLDAP) ───────────────────────────
# Facultatif : tout se configure aussi depuis Comptes → Active Directory,
# ce qui est préférable car le mot de passe y est alors chiffré en base.
# Les valeurs ci-dessous ne servent que de défauts au premier démarrage.
LDAP_ENABLED=false
LDAP_URL=
LDAP_URL_FALLBACK=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(objectClass=person)
LDAP_LOGIN_ATTRS=sAMAccountName,uid,userPrincipalName,mail
LDAP_GROUP_BASE_DN=
# Décocher la vérification du nom d'hôte si vos contrôleurs répondent derrière
# un DNS de domaine en round-robin. La chaîne de certification reste vérifiée.
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TLS_CHECK_HOSTNAME=true
LDAP_CA_CERT_PEM=
# Rôle des comptes d'annuaire sans correspondance de groupe.
LDAP_DEFAULT_ROLE=viewer
LDAP_AUTO_CREATE=true

# ── Alertes par courriel ─────────────────────────────────────
# Sans SMTP, un renouvellement qui échoue la nuit ne réveille personne : les
# alertes sont alors seulement inscrites dans le journal du service.
# Chaque cible de déploiement porte sa propre adresse de destination.
#SMTP_HOST=smtp.exemple.fr
#SMTP_PORT=25
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=certfleet@exemple.fr
